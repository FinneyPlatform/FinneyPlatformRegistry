<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Training-cost calculator</title><style>body{font:18px system-ui;line-height:1.6;max-width:1000px;margin:2rem auto;padding:1rem;color:#17252d;background:#fff}label{display:block;margin-top:1rem}input,select,button{font:inherit;padding:.5rem;margin:.25rem}table{border-collapse:collapse;width:100%}th,td{border:1px solid #777;padding:.5rem;text-align:left}button:focus,input:focus,select:focus{outline:3px solid #075cab}#error{color:#9b1717}</style><main><h1>Training-cost calculator</h1><p>Local fictional training prototype. No network or production authority.</p><p>USD. Monthly recurring = seats × monthly unit price. First month = recurring + one-time setup. No tax or discounts.</p><form id="form" novalidate><label for="a">Seats A</label><input id="a" inputmode="decimal"><label for="price">Monthly unit price USD</label><input id="price" inputmode="decimal"><label for="setup">One-time setup USD</label><input id="setup" inputmode="decimal"><button type="submit">Calculate</button><button type="reset">Reset</button></form><pre id="result" aria-live="polite"></pre><p id="error" role="alert"></p></main><script>
const compare=false;
function value(id,max,integer){const x=document.getElementById(id).value.trim();if(!x||!/^[0-9]+(?:\.[0-9]{1,2})?$/.test(x)||Number(x)>max||(integer&&!/^[0-9]+$/.test(x)))throw Error(document.querySelector('label[for="'+id+'"]').textContent+': enter '+(integer?'a whole number':'an amount with up to two decimals')+' from 0 to '+max);return Number(x)}
function clear(){document.querySelector('#result').textContent='';document.querySelector('#error').textContent=''}
document.querySelector('#form').oninput=clear;document.querySelector('#form').onreset=clear;
document.querySelector('#form').onsubmit=e=>{e.preventDefault();clear();try{const a=value('a',500,true),price=value('price',1000,false),setup=value('setup',100000,false);const cents=Math.round(price*100),setupCents=Math.round(setup*100);let text='A recurring USD '+(a*cents/100).toFixed(2)+'; first month USD '+((a*cents+setupCents)/100).toFixed(2);if(compare){const b=value('b',500,true);text+='\nB recurring USD '+(b*cents/100).toFixed(2)+'; first month USD '+((b*cents+setupCents)/100).toFixed(2)+'\nB minus A recurring and first-month difference USD '+((b-a)*cents/100).toFixed(2)}document.querySelector('#result').textContent=text}catch(x){document.querySelector('#error').textContent=x.message}};
</script></html>