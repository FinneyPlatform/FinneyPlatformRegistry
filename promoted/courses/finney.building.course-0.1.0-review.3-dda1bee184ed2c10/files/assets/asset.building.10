HTML source retained as inert text. Save it as an .html file only if you intentionally want to run it locally.

<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Budget and actual dashboard</title><style>body{font:18px system-ui;line-height:1.6;max-width:1000px;margin:2rem auto;padding:1rem;color:#17252d;background:#fff}label{display:block;margin-top:1rem}input,select,button{font:inherit;padding:.5rem;margin:.25rem}table{border-collapse:collapse;width:100%}th,td{border:1px solid #777;padding:.5rem;text-align:left}button:focus,input:focus,select:focus{outline:3px solid #075cab}#error{color:#9b1717}</style><main><h1>Budget and actual dashboard</h1><p>Local fictional training prototype. No network or production authority.</p><p>All values USD 000. Variance = actual − budget; positive means above budget.</p><label for="unit">Unit</label><select id="unit"><option>all</option><option>EAST</option><option>WEST</option></select><label for="file">Replace with local JSON</label><input id="file" type="file" accept=".json"><p id="summary" aria-live="polite"></p><table><caption>Budget and actual, USD 000</caption><thead><tr><th>Unit</th><th>Department</th><th>Period</th><th>Budget</th><th>Actual</th><th>Variance</th></tr></thead><tbody id="rows"></tbody></table><p id="error" role="alert"></p></main><script>
let data=[{"unit": "EAST", "department": "Ops", "period": "2026-09", "currency": "USD", "budget": 100, "actual": 110}, {"unit": "EAST", "department": "Sales", "period": "2026-09", "currency": "USD", "budget": 80, "actual": 70}, {"unit": "WEST", "department": "Ops", "period": "2026-09", "currency": "USD", "budget": 120, "actual": 125}, {"unit": "WEST", "department": "Sales", "period": "2026-09", "currency": "USD", "budget": 50, "actual": 55}];
function validate(rows){if(!Array.isArray(rows))throw Error('Expected an array');const keys=new Set(),periods=new Set();for(const r of rows){if(!r||!['EAST','WEST'].includes(r.unit)||typeof r.department!=='string'||!r.department||r.currency!=='USD'||!/^\d{4}-(0[1-9]|1[0-2])$/.test(r.period)||!Number.isFinite(r.budget)||!Number.isFinite(r.actual))throw Error('Invalid row fields, currency or period');const key=[r.unit,r.department,r.period].join('/');if(keys.has(key))throw Error('Duplicate key');keys.add(key);periods.add(r.period)}if(periods.size>1)throw Error('Use one period');return rows}
function render(){const unit=document.querySelector('#unit').value;const rows=data.filter(r=>unit==='all'||r.unit===unit);const b=rows.reduce((s,r)=>s+r.budget,0),a=rows.reduce((s,r)=>s+r.actual,0);document.querySelector('#summary').textContent=(data.length?data[0].period:'Empty dataset')+' | rows '+rows.length+' | budget '+b+' | actual '+a+' | variance '+(a-b)+' USD 000';const tb=document.querySelector('#rows');tb.replaceChildren();for(const r of rows){const tr=document.createElement('tr');for(const v of [r.unit,r.department,r.period,r.budget,r.actual,r.actual-r.budget]){const td=document.createElement('td');td.textContent=v;tr.append(td)}tb.append(tr)}}
document.querySelector('#unit').onchange=render;
document.querySelector('#file').onchange=async e=>{try{const f=e.target.files[0];if(!f)return;const candidate=validate(JSON.parse(await f.text()));data=candidate;document.querySelector('#unit').value='all';document.querySelector('#error').textContent='';render()}catch(x){document.querySelector('#error').textContent=x.message}};
render();
</script></html>